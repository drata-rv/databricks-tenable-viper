[
  {
    "id": "scan-data-current",
    "name": "Vipr Scan Data Is Current",
    "editor": "Builder",
    "description": "Vipr vulnerability data was refreshed within the allowed age and the nightly sync ran in the last 2 days.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      },
      {
        "id": "DCF-455",
        "name": "Quarterly Internal Vulnerability Scans"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "scanSummary"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "sourceFresh",
          "operator": "equal",
          "value": true
        },
        {
          "fact": "generatedAt",
          "operator": "withinLastDays",
          "value": 2
        }
      ]
    },
    "note": "Only this test checks freshness; the others score the records as delivered."
  },
  {
    "id": "critical-addressed",
    "name": "Vipr Critical Vulnerabilities Addressed",
    "editor": "Builder",
    "description": "No open critical vulnerability is past its SLA date, and none has an undetermined SLA status. Ignored findings are not submitted.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      },
      {
        "id": "DCF-160",
        "name": "Service Level Agreements (SLAs) for Security"
      },
      {
        "id": "DCF-456",
        "name": "Vulnerabilities Identified and Resolved"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "findingPartition"
          },
          {
            "fact": "severity",
            "operator": "equal",
            "value": "critical"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "openSlaBreachedCount",
          "operator": "equal",
          "value": 0
        },
        {
          "fact": "openSlaUnknownCount",
          "operator": "equal",
          "value": 0
        }
      ]
    }
  },
