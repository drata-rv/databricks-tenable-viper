[
  {
    "id": "scan-data-current",
    "name": "Vipr Scan Data Is Current",
    "editor": "Builder",
    "description": "Vipr vulnerability data was refreshed within the allowed age and the nightly sync ran in the last 2 days.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      },
      {
        "id": "DCF-455",
        "name": "Quarterly Internal Vulnerability Scans"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "scanSummary"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "sourceFresh",
          "operator": "equal",
          "value": true
        },
        {
          "fact": "generatedAt",
          "operator": "withinLastDays",
          "value": 2
        }
      ]
    },
    "note": "Tests 2-8 also require a sync within the last 2 days, so a stopped job fails them."
  },
  {
    "id": "critical-addressed",
