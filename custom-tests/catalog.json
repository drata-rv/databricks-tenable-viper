  {
    "id": "medium-low-within-sla",
    "name": "Vipr Medium and Low Vulnerabilities Within SLA",
    "editor": "Advanced",
    "description": "No open medium or low vulnerability is past its SLA date, and none has an undetermined SLA status. Ignored findings are not submitted.",
    "controls": [
      {
        "id": "DCF-160",
        "name": "Service Level Agreements (SLAs) for Security"
      },
      {
        "id": "DCF-456",
        "name": "Vulnerabilities Identified and Resolved"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "findingPartition"
          },
          {
            "fact": "severity",
