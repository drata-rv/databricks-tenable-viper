  {
    "id": "assets-seen-recently",
    "name": "Vipr Assets Seen Recently",
    "editor": "Builder",
    "description": "Every asset in the Vipr inventory was seen within the stale window.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "assetPartition"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "sourceFresh",
          "operator": "equal",
          "value": true
        },
        {
          "fact": "generatedAt",
          "operator": "withinLastDays",
          "value": 2
        },
        {
          "fact": "staleAssetCount",
          "operator": "equal",
          "value": 0
        }
      ]
    },
    "note": "The stale window is SCAN_STALE_DAYS (default 7). Assets with no last-seen date are not counted."
  },
  {
    "id": "critical-high-sla-items",
    "name": "Vipr Critical and High Findings Within SLA (Item Level)",
    "editor": "Advanced",
    "description": "No open critical or high finding is past its SLA date, checked finding by finding.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      },
      {
        "id": "DCF-160",
        "name": "Service Level Agreements (SLAs) for Security"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "findingPartition"
          },
          {
            "fact": "severity",
            "operator": "in",
            "value": [
              "critical",
              "high"
            ]
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "sourceFresh",
          "operator": "equal",
          "value": true
        },
        {
          "fact": "generatedAt",
          "operator": "withinLastDays",
          "value": 2
        },
        {
          "fact": "findings",
          "operator": "none",
          "value": {
            "all": [
              {
                "fact": "open",
                "operator": "equal",
