  {
    "id": "critical-high-ticketed",
    "name": "Vipr Critical and High Vulnerabilities Are Ticketed",
    "editor": "Advanced",
    "description": "Every open critical and high vulnerability has a ticket, so it is tracked to resolution.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      },
      {
        "id": "DCF-315",
        "name": "Management of Security Vulnerabilities"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "findingPartition"
          },
          {
            "fact": "severity",
            "operator": "in",
            "value": [
              "critical",
              "high"
            ]
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "openMissingTicketCount",
          "operator": "equal",
          "value": 0
        },
        {
          "fact": "openTicketUnknownCount",
          "operator": "equal",
          "value": 0
        }
      ]
    }
  },
  {
    "id": "assets-seen-recently",
    "name": "Vipr Assets Seen Recently",
    "editor": "Builder",
    "description": "Every asset in the Vipr inventory was seen within the stale window.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "assetPartition"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "staleAssetCount",
          "operator": "equal",
          "value": 0
        }
      ]
    },
    "note": "The stale window is SCAN_STALE_DAYS (default 7). Assets with no last-seen date are not counted."
  },
  {
    "id": "critical-high-sla-items",
    "name": "Vipr Critical and High Findings Within SLA (Item Level)",
    "editor": "Advanced",
    "description": "No open critical or high finding is past its SLA date, checked finding by finding. Ignored findings are not submitted.",
    "controls": [
      {
        "id": "DCF-18",
        "name": "Vulnerability Scans"
      },
      {
        "id": "DCF-160",
        "name": "Service Level Agreements (SLAs) for Security"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "findingPartition"
          },
          {
            "fact": "severity",
            "operator": "in",
            "value": [
              "critical",
              "high"
            ]
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "findings",
          "operator": "none",
          "value": {
            "all": [
              {
                "fact": "open",
                "operator": "equal",
                "value": true
              },
              {
                "fact": "slaBreached",
                "operator": "equal",
                "value": true
              }
            ]
          }
        }
      ]
    }
  },
  {
    "id": "critical-open-age",
    "name": "Vipr Open Critical Findings Not Older Than 30 Days",
    "editor": "Advanced",
    "description": "No open critical finding was first seen more than 30 days ago. Ignored findings are not submitted.",
    "controls": [
      {
        "id": "DCF-160",
        "name": "Service Level Agreements (SLAs) for Security"
      },
      {
        "id": "DCF-456",
        "name": "Vulnerabilities Identified and Resolved"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "findingPartition"
          },
          {
            "fact": "severity",
            "operator": "equal",
            "value": "critical"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "findings",
          "operator": "none",
          "value": {
            "all": [
              {
                "fact": "open",
                "operator": "equal",
                "value": true
              },
              {
                "fact": "firstSeen",
                "operator": "olderThanDays",
                "value": 30
              }
            ]
          }
        }
      ]
    },
    "note": "The 30-day window is a placeholder; set the day count to the policy window."
  },
  {
    "id": "ignored-source-recorded",
    "name": "Vipr Ignored Findings Have a Recorded Source",
    "editor": "Builder",
    "diagnostic": true,
    "description": "Every ignored finding names the automation rule or person that ignored it.",
    "controls": [],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "ignoreSummary"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "ignoredWithoutSourceCount",
          "operator": "equal",
          "value": 0
        }
      ]
    },
    "note": "Diagnostic, not a compliance test: a failure means Vipr holds an ignore with no recorded source. The two tests below do not count those findings."
  },
  {
    "id": "ignored-have-owner",
    "name": "Vipr Ignored Findings Have an Owner",
    "editor": "Builder",
    "description": "Every ignored finding with a recorded source has a remediation or security owner.",
    "controls": [
      {
        "id": "DCF-15",
        "name": "Name to confirm in tenant"
      },
      {
        "id": "DCF-17",
        "name": "Name to confirm in tenant"
      },
      {
        "id": "DCF-183",
        "name": "Name to confirm in tenant"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "ignoreSummary"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "ignoredWithoutOwnerCount",
          "operator": "equal",
          "value": 0
        }
      ]
    }
  },
  {
    "id": "manual-ignores-have-rationale",
    "name": "Vipr Manual Ignores Have a Rationale",
    "editor": "Advanced",
    "description": "Every finding ignored by a person has a written rationale. An automation rule is its own rationale.",
    "controls": [
      {
        "id": "DCF-15",
        "name": "Name to confirm in tenant"
      },
      {
        "id": "DCF-17",
        "name": "Name to confirm in tenant"
      },
      {
        "id": "DCF-183",
        "name": "Name to confirm in tenant"
      }
    ],
    "filter": {
      "mode": "inclusion",
      "evaluator": {
        "all": [
          {
            "fact": "recordType",
            "operator": "equal",
            "value": "ignoreSummary"
          }
        ]
      }
    },
    "condition": {
      "all": [
        {
          "fact": "manualIgnores",
          "operator": "none",
          "value": {
            "all": [
              {
                "fact": "hasRationale",
                "operator": "equal",
                "value": false
              }
            ]
          }
        },
        {
          "fact": "manualIgnoreWithoutRationaleCount",
          "operator": "equal",
          "value": 0
        }
      ]
    },
    "note": "The list holds the first 1000 manual ignores; the count covers all of them."
  }
]
