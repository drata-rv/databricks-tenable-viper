# Databricks (local dev). Prod uses secret scope + --env job params.
DATABRICKS_HOST_TEST=
DATABRICKS_TOKEN_TEST=
DATABRICKS_CLIENT_ID_TEST=
DATABRICKS_CLIENT_SECRET_TEST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_SECRET_SCOPE_TEST=vipr-drata-test
DATABRICKS_SECRET_SCOPE_PROD=vipr-drata-prod

# Source tables (fully qualified)
VIPR_FINDINGS_TABLE=si_test_catalog.nw_harmonized_sensitive.t_vipr_all_findings
VIPR_ASSETS_TABLE=si_test_catalog.nw_harmonized_sensitive.t_vipr_all_assets
# Optional scanner-activity evidence (leave empty to skip)
TENABLE_ASSETS_TABLE=
VIPR_CVES_TABLE=
VIPR_EVIDENCE_TABLE=

# Drata destination. DRATA_PROD=false -> sandbox secret names; true -> *-prod names (must be provisioned).
DRATA_PROD=false
DRATA_API_KEY=
DRATA_API_KEY_PROD=
DRATA_API_BASE=https://public-api.drata.com
# CUSTOM connections (Drata UI/API -> connectionId; GET /public/v2/custom-connections/{id}?expand[]=customResources -> resourceId)
DRATA_FINDINGS_CONNECTION_ID=
DRATA_FINDINGS_RESOURCE_ID=
DRATA_ASSETS_CONNECTION_ID=
DRATA_ASSETS_RESOURCE_ID=
# upsert (default, never deletes) | session (atomic snapshot replace; hard-deletes records not in the run)
DRATA_PUSH_MODE=upsert
SCAN_STALE_DAYS=7
